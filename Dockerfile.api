FROM node:24-bookworm

WORKDIR /app

# Keep the browser in a deterministic, system-wide path.  Defining this before
# installation is important: Playwright must use the same path at build time
# and at runtime, regardless of the HOME selected by the hosting platform.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY apps/api/package.json apps/api/package-lock.json ./apps/api/
RUN npm ci --include=dev --prefix apps/api \
    && cd apps/api \
    && npx playwright install --with-deps chromium

COPY apps/api ./apps/api
COPY sql ./sql

RUN npm run build --prefix apps/api \
    && npm prune --omit=dev --prefix apps/api

ENV NODE_ENV=production

CMD ["sh", "-c", "node apps/api/scripts/migrate.js && npm run start:prod --prefix apps/api"]
