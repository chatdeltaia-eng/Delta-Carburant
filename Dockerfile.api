FROM node:24-bookworm

WORKDIR /app

# Bundle Chromium with the application instead of placing it in an ephemeral
# build cache. This works for both Docker and Render's native Node runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=0

COPY apps/api/package.json apps/api/package-lock.json ./apps/api/
RUN npm ci --include=dev --prefix apps/api \
    && cd apps/api \
    && npx playwright install --with-deps chromium

COPY apps/api ./apps/api
COPY sql ./sql

RUN npm run build --prefix apps/api \
    && npm prune --omit=dev --prefix apps/api

ENV NODE_ENV=production

CMD ["sh", "-c", "node apps/api/scripts/migrate.js && npm run start:prod --prefix apps/api"]
